# Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local environment.

# GPU Device Selection (e.g., 0 for first GPU)
CUDA_VISIBLE_DEVICES=0

# Python Path configuration
PYTHONPATH=.

# Default dataset and experiment output directories
DATA_DIR=data
RUNS_DIR=runs

# PyTorch execution flags (optional)
# TORCH_CUDA_ARCH_LIST="8.9;9.0;12.0"
# PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
